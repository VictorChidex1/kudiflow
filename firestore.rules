rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =====================================================================
    // HELPER FUNCTIONS
    // =====================================================================
    
    // Checks if the requesting user has been granted the 'admin' role
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }
    
    // Checks if the requesting user is the owner of the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // =====================================================================
    // DEFAULT RULE: Zero-Trust (Deny Everything Unless Explicitly Allowed)
    // =====================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =====================================================================
    // USERS COLLECTION (Profile Data)
    // =====================================================================
    match /users/{userId} {
      // Super Admins can read ALL user profiles (for the God-Mode inspector)
      allow read: if isOwner(userId) || isAdmin();
      
      // Only the owner can update or delete their own profile
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
      
      // Strict Schema Validation for initial profile creation
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasAll(['uid', 'email', 'fullName', 'shopName', 'phone', 'createdAt', 'authProvider']) &&
        request.resource.data.uid is string && request.resource.data.uid == userId &&
        request.resource.data.email is string &&
        request.resource.data.fullName is string && request.resource.data.fullName.size() <= 100 &&
        request.resource.data.shopName is string && request.resource.data.shopName.size() <= 100 &&
        request.resource.data.phone is string && request.resource.data.phone.size() <= 50 &&
        request.resource.data.authProvider in ['email', 'google'] &&
        request.resource.data.createdAt == request.time;
    }

    // =====================================================================
    // USER SUBCOLLECTIONS (Inventory, Sales, Debtors, Settings, Repayments...)
    // =====================================================================
    
    // Single-level subcollections: users/{userId}/sales/{docId}
    match /users/{userId}/{subcollection}/{docId} {
      // Owner has full access. Super Admins have READ-ONLY access to ALL subcollections.
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }
    
    // Deep nested subcollections: users/{userId}/debtors/{debtorId}/repayments/{repaymentId}
    match /users/{userId}/{subcollection}/{docId}/{nested=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // =====================================================================
    // CONTACT MESSAGES
    // =====================================================================
    match /contact_messages/{msgId} {
      // Super Admins can read all contact messages in the God-Mode panel
      allow read: if isAdmin();
      allow update, delete: if false;
      
      // Strict Schema Validation for creation (web contact form)
      allow create: if 
        request.resource.data.keys().hasAll(['fullName', 'contact', 'storeName', 'message', 'createdAt', 'status', 'recaptchaToken']) &&
        request.resource.data.keys().hasOnly(['fullName', 'contact', 'storeName', 'message', 'createdAt', 'status', 'recaptchaToken']) &&
        request.resource.data.fullName is string && request.resource.data.fullName.size() <= 100 &&
        request.resource.data.contact is string && request.resource.data.contact.size() <= 100 &&
        request.resource.data.storeName is string && request.resource.data.storeName.size() <= 100 &&
        request.resource.data.message is string && request.resource.data.message.size() <= 500 &&
        request.resource.data.recaptchaToken is string &&
        request.resource.data.status == 'new' && 
        request.resource.data.createdAt == request.time;
    }

    // =====================================================================
    // LEGACY ROOT-LEVEL COLLECTIONS (backward compatibility)
    // =====================================================================
    match /inventory/{itemId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /sales/{saleId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /debtors/{debtorId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // God-Mode admin dashboard data
    match /admin_data/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
