rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =====================================================================
    // HELPER FUNCTIONS
    // =====================================================================
    
    // Checks if the requesting user has been granted the 'admin' role
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }
    
    // Checks if the requesting user is the owner of the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // =====================================================================
    // DEFAULT RULE: Zero-Trust (Deny Everything Unless Explicitly Allowed)
    // =====================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =====================================================================
    // USERS COLLECTION (Profile Data)
    // =====================================================================
    match /users/{userId} {
      // Super Admins can read ALL user profiles (for the God-Mode inspector)
      allow read: if isOwner(userId) || isAdmin();
      
      // Strict Schema Validation for Profile Updates (Prevents Privilege Escalation)
      allow update: if isOwner(userId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'createdAt']));
      
      allow delete: if isOwner(userId);
      
      // Strict Schema Validation for initial profile creation
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasAll(['uid', 'email', 'fullName', 'shopName', 'phone', 'createdAt', 'authProvider']) &&
        request.resource.data.uid is string && request.resource.data.uid == userId &&
        request.resource.data.email is string &&
        request.resource.data.fullName is string && request.resource.data.fullName.size() <= 100 &&
        request.resource.data.shopName is string && request.resource.data.shopName.size() <= 100 &&
        request.resource.data.phone is string && request.resource.data.phone.size() <= 50 &&
        request.resource.data.authProvider in ['email', 'google'] &&
        request.resource.data.createdAt == request.time;
    }

    // =====================================================================
    // USER SUBCOLLECTIONS (Inventory, Sales, Debtors, Settings, Repayments...)
    // =====================================================================
    
    // ---------------------------------------------------------------------
    // EXPLICIT SUBCOLLECTION SCHEMA VALIDATIONS (Prevents Logic Flaws)
    // ---------------------------------------------------------------------

    match /users/{userId}/inventory/{itemId} {
      allow read: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId);
      
      // ZERO-TRUST INVENTORY FORTIFICATION:
      // Prevents billing attacks (massive string payloads) and schema poisoning.
      allow create, update: if isOwner(userId) &&
        // 1. Required Fields
        request.resource.data.keys().hasAll(['productName', 'costPrice', 'sellingPrice', 'stockLevel', 'userId']) &&
        request.resource.data.userId == userId &&
        
        // 2. Strict String Size Limits (Anti-Bloat)
        request.resource.data.productName is string && request.resource.data.productName.size() <= 100 &&
        (request.resource.data.get('category', '') == null || (request.resource.data.get('category', '') is string && request.resource.data.get('category', '').size() <= 50)) &&
        (request.resource.data.get('sku', '') == null || (request.resource.data.get('sku', '') is string && request.resource.data.get('sku', '').size() <= 50)) &&
        (request.resource.data.get('unit', '') == null || (request.resource.data.get('unit', '') is string && request.resource.data.get('unit', '').size() <= 20)) &&
        (request.resource.data.get('expiryDate', '') == null || (request.resource.data.get('expiryDate', '') is string && request.resource.data.get('expiryDate', '').size() <= 20)) &&
        (request.resource.data.get('notes', '') == null || (request.resource.data.get('notes', '') is string && request.resource.data.get('notes', '').size() <= 500)) &&
        (request.resource.data.get('imageUrl', '') == null || (request.resource.data.get('imageUrl', '') is string && request.resource.data.get('imageUrl', '').size() <= 1000)) &&
        
        // 3. Strict Numeric Bounds (No Negative Finances)
        request.resource.data.costPrice is number && request.resource.data.costPrice >= 0 &&
        request.resource.data.sellingPrice is number && request.resource.data.sellingPrice >= 0 &&
        request.resource.data.stockLevel is number && request.resource.data.stockLevel >= 0 &&
        (request.resource.data.get('wholesalePrice', 0) == null || (request.resource.data.get('wholesalePrice', 0) is number && request.resource.data.get('wholesalePrice', 0) >= 0)) &&
        (request.resource.data.get('minStockLevel', 0) == null || (request.resource.data.get('minStockLevel', 0) is number && request.resource.data.get('minStockLevel', 0) >= 0));
    }

    match /users/{userId}/sales/{saleId} {
      allow read: if isOwner(userId) || isAdmin();
      // Ensure negative sales cannot be processed
      allow write: if isOwner(userId) &&
        (request.resource.data.totalAmount == null || (request.resource.data.totalAmount is number && request.resource.data.totalAmount >= 0));
    }

    match /users/{userId}/debtors/{debtorId} {
      allow read: if isOwner(userId) || isAdmin();
      // Ensure balance owed cannot be arbitrarily negative to spoof refunds
      allow write: if isOwner(userId) &&
        (request.resource.data.balanceOwed == null || (request.resource.data.balanceOwed is number && request.resource.data.balanceOwed >= 0));
    }
    
    // Deep nested subcollections fallback (e.g., repayments)
    match /users/{userId}/{subcollection}/{docId}/{nested=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // =====================================================================
    // CONTACT MESSAGES
    // =====================================================================
    match /contact_messages/{msgId} {
      // Super Admins can read all contact messages in the God-Mode panel
      allow read: if isAdmin();
      
      // We completely shut down client-side writes!
      // All creation MUST route through the V2 Callable Cloud Function "submitContactForm"
      allow write: if false;
    }

    // =====================================================================
    // LEGACY ROOT-LEVEL COLLECTIONS (backward compatibility)
    // =====================================================================
    match /inventory/{itemId} {
      // Security: Multi-Tenant Iron Wall. You can only touch your own products.
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /sales/{saleId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /debtors/{debtorId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // God-Mode admin dashboard data
    match /admin_data/{document=**} {
      allow read, write: if isAdmin();
    }

    // =====================================================================
    // GLOBAL BLOGS COLLECTION (CMS)
    // =====================================================================
    match /blogs/{blogId} {
      // Anyone can read blogs (for the public blog hub)
      allow read: if true;
      
      // Only Super Admins can write, update, or delete blog posts
      allow write: if isAdmin();
    }
  }
}
